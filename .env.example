# 경로 (기본값: ./data/...)
KNOWLEDGE_DIR=./data/knowledge
ASSETS_DIR=./data/assets
BROWSER_PROFILE=./data/browser-profile
INDEX_DB=./data/index.db

# 맥미니에서는 Tailscale IP 또는 0.0.0.0 (Tailscale ACL로 제한)
HOST=127.0.0.1
WEB_PORT=4321
MCP_PORT=4322
MCP_TOKEN=

# 텔레그램 (BotFather) — 이 파일에만. 저장소에 commit 금지
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Imgur (선택). 비우면 로컬 자산 경로만 사용
IMGUR_CLIENT_ID=
IMGUR_CLIENT_SECRET=
IMGUR_REFRESH_TOKEN=

# git push (knowledge·assets 저장소에 remote가 있을 때 1)
GIT_PUSH=0

# LLM 순서 (쉼표). 사용 가능: agy, gemini, codex, claude, ollama
LLM_TRIAGE_ORDER=ollama,gemini,agy
LLM_REDUCE_ORDER=gemini,agy,codex,claude
LLM_REFLECT_ORDER=claude
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=bge-m3
